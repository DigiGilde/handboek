---
import { execFileSync } from 'node:child_process';
import { realpathSync } from 'node:fs';
import { relative } from 'node:path';
import { getCollection, render, type CollectionEntry } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import { pageHref, sectionHref, sectionOf, sections } from '../navigation';

export async function getStaticPaths() {
    // The home page, the projects and the section overviews have pages of their own.
    const overviews = new Set(['index', 'projecten', ...sections.map((section) => section.slug)]);
    const entries = await getCollection('handboek', (entry) => !overviews.has(entry.id));
    return entries.map((entry) => ({
        params: { slug: entry.id.replace(/\/index$/, '') },
        props: { entry },
    }));
}

interface Props {
    entry: CollectionEntry<'handboek'>;
}

const { entry } = Astro.props;
const { Content, headings, remarkPluginFrontmatter } = await render(entry);
const title: string | undefined = remarkPluginFrontmatter.title;
const section = sectionOf(entry.id);

// "Lees ook" lists the pages chosen in `related`, from any section, or else the
// other pages of this section.
const entries = await getCollection('handboek');
const allPages = sections.flatMap((item) => item.pages);
const related = entry.data.related
    ? await Promise.all(
          entry.data.related.map(async (id) => {
              const page = allPages.find((item) => item.id === id);
              if (page) return page;
              const overview = sections.find((item) => item.slug === id);
              if (overview) return { id, title: overview.title, description: overview.summary };
              // A page outside the navigation, such as the projects, is titled by its h1.
              const other = entries.find((item) => item.id === id);
              if (!other) throw new Error(`${entry.id}: related page "${id}" does not exist`);
              const title: string = (await render(other)).remarkPluginFrontmatter.title;
              return { id, title };
          }),
      )
    : (section?.pages.filter((page) => page.id !== entry.id) ?? []);
const readMore = related.slice(0, 5).map((page) => ({
    ...page,
    description: page.description ?? entries.find((item) => item.id === page.id)?.data.description,
}));

const git = (...args: string[]) =>
    execFileSync('git', args, { encoding: 'utf8', stdio: ['ignore', 'pipe', 'ignore'] });
// Front matter is site metadata, not text the reader sees.
const body = (markdown: string) => markdown.replace(/^---\n[\s\S]*?\n---\n/, '').trimStart();

// Date of the last commit that changed the text of the page.
function lastModified(file: string | undefined): Date | undefined {
    if (!file) return undefined;
    try {
        // A page can be a symlink (bijdragen-aan-handboek.md -> CONTRIBUTING.md);
        // its history is the target's.
        const real = realpathSync(file);
        const path = relative(git('rev-parse', '--show-toplevel').trim(), real);
        const show = (revision: string) => {
            try {
                return body(git('show', `${revision}:${path}`));
            } catch {
                return undefined;
            }
        };
        for (const line of git('log', '--format=%H %cI', '--', real).trim().split('\n')) {
            const [commit, date] = line.split(' ');
            if (commit && show(commit) !== show(`${commit}^`)) return new Date(date);
        }
        return undefined;
    } catch {
        return undefined;
    }
}

const updated = lastModified(entry.filePath);

// A table of contents where it helps (the NLDD content page pattern): three or
// more h2's, or a text longer than about two screens.
const toc = headings.filter((heading) => heading.depth === 2);
const hasToc = toc.length >= 3 || (toc.length >= 2 && (entry.body ?? '').length > 4000);
const Section = hasToc ? 'nldd-sidebar-section' : 'nldd-simple-section';
const breadcrumbs = section
    ? [
          { text: section.title, href: sectionHref(section) },
          { text: section.pages.find((page) => page.id === entry.id)?.title ?? title ?? '' },
      ]
    : [{ text: title ?? '' }];
---

<Layout
    title={title}
    description={entry.data.description}
    breadcrumbs={breadcrumbs}
    updated={updated}
    back={section && { text: section.title, href: sectionHref(section) }}
>
    <Section id="inhoud" grow {...(hasToc ? { 'sidebar-label': 'Op deze pagina' } : {})}>
        <nldd-title slot="header"><h1>{title}</h1></nldd-title>
        {
            hasToc && (
                <>
                    <nldd-spacer slot="header" sidebar-section-only="collapsed" size="16" />
                    <nldd-button
                        slot="header"
                        id="toc-open"
                        sidebar-section-only="collapsed"
                        appearance="secondary"
                        start-icon="bullet-list"
                        text="Op deze pagina"
                        popup-type="dialog"
                    />
                    <nldd-container slot="sidebar" padding="16" padding-bottom="8">
                        <nldd-title sidebar-section-only="expanded" size="display-5">
                            <h2>Op deze pagina</h2>
                        </nldd-title>
                        <nldd-spacer sidebar-section-only="expanded" size="8" />
                        {/* No `current` on a row: with nothing else showing the place, its fill fails WCAG 1.4.1 and 1.4.11. */}
                        <nldd-list type="navigation" appearance="simple" dividers="never" accessible-label="Op deze pagina">
                            {toc.map((heading) => (
                                <nldd-list-item href={`#${heading.slug}`} current-type="location">
                                    <nldd-text-cell>
                                        <p>{heading.text}</p>
                                    </nldd-text-cell>
                                </nldd-list-item>
                            ))}
                        </nldd-list>
                    </nldd-container>
                </>
            )
        }
        <nldd-rich-text data-pagefind-body>
            <Content />
        </nldd-rich-text>
    </Section>
    {
        readMore.length > 0 && (
            <nldd-simple-section background="tinted">
                <nldd-title slot="header" size="display-3">
                    <h2>Lees ook</h2>
                </nldd-title>
                <nldd-collection layout="grid" item-min-width="280px">
                    {readMore.map((page) => (
                        <nldd-card href={pageHref(page.id)} accessible-label={page.title}>
                            <nldd-container padding="16">
                                <nldd-title size="display-5">
                                    <h3>{page.title}</h3>
                                </nldd-title>
                                {page.description && (
                                    <>
                                        <nldd-spacer size="4" />
                                        <nldd-rich-text>
                                            <p>{page.description}</p>
                                        </nldd-rich-text>
                                    </>
                                )}
                            </nldd-container>
                        </nldd-card>
                    ))}
                </nldd-collection>
            </nldd-simple-section>
        )
    }
</Layout>

<script>
    type SidebarSection = HTMLElement & { show(): void };
    const section = document.getElementById('inhoud') as SidebarSection | null;
    const opener = document.getElementById('toc-open');
    if (section && opener) {
        opener.addEventListener('click', () => section.show());
        section.addEventListener('open', () => opener.setAttribute('expanded', ''));
        section.addEventListener('close', () => opener.removeAttribute('expanded'));
    }
</script>
