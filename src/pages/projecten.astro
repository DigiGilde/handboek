---
import { getEntry, render } from 'astro:content';
import Layout from '../layouts/Layout.astro';

const entry = await getEntry('handboek', 'projecten');
if (!entry) throw new Error('docs/projecten.md is missing');
const { Content, remarkPluginFrontmatter } = await render(entry);
const title: string = remarkPluginFrontmatter.title;
const projects = entry.data.projects ?? [];
// An id per project gives the search a result per project that jumps to its card.
const slug = (text: string) =>
    text
        .normalize('NFD')
        .replace(/[\u0300-\u036f]/g, '')
        .toLowerCase()
        .replace(/[^a-z0-9]+/g, '-')
        .replace(/^-|-$/g, '');
---

<Layout title={title} description={entry.data.description} breadcrumbs={[{ text: title }]}>
    <nldd-simple-section id="inhoud" data-pagefind-body>
        <nldd-title slot="header"><h1>{title}</h1></nldd-title>
        <nldd-spacer slot="header" size="16" />
        <nldd-rich-text slot="header">
            <Content />
        </nldd-rich-text>
        <nldd-collection layout="grid" item-min-width="320px">
            {
                projects.map((project) => (
                    <nldd-card>
                        <nldd-container padding="16">
                            <nldd-title size="display-4">
                                <h2 id={slug(project.title)}>{project.title}</h2>
                            </nldd-title>
                            <nldd-spacer size="8" />
                            <nldd-tag size="sm" text={project.kind} />
                            <nldd-spacer size="8" />
                            <nldd-rich-text>
                                <p>{project.description}</p>
                            </nldd-rich-text>
                        </nldd-container>
                        <nldd-container slot="footer" padding-inline="16" padding-bottom="16">
                            <nldd-button appearance="neutral-tinted" text={`Naar ${project.title}`} href={project.href} />
                        </nldd-container>
                    </nldd-card>
                ))
            }
        </nldd-collection>
    </nldd-simple-section>
</Layout>
