---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Pagina niet gevonden">
    <nldd-simple-section id="inhoud">
        <nldd-title slot="header" size="1" text="Pagina niet gevonden" heading-level="1" />
        <nldd-rich-text>
            <p>Deze pagina bestaat niet (meer). Misschien is hij verplaatst of hernoemd.</p>
            <p>
                Ga naar de <a href={import.meta.env.BASE_URL}>startpagina</a> of gebruik Zoeken bovenaan de pagina.
            </p>
        </nldd-rich-text>
    </nldd-simple-section>
</Layout>
