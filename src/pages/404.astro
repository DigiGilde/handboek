---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Pagina niet gevonden" breadcrumbs={[{ text: "Pagina niet gevonden" }]}>
    <nldd-simple-section id="inhoud">
        <nldd-title slot="header"><h1>Pagina niet gevonden</h1></nldd-title>
        <nldd-rich-text>
            <p>Deze pagina bestaat niet (meer). Misschien is hij verplaatst of hernoemd.</p>
            <p>
                Ga naar de <a href={import.meta.env.BASE_URL}>startpagina</a> of gebruik Zoeken bovenaan de pagina.
            </p>
        </nldd-rich-text>
    </nldd-simple-section>
</Layout>
